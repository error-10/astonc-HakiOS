+/*
+ * The DSP's battery manager has gone quiet (bsd/dev/hakios.adsp.c, battmgr_thread: rounds in a
+ * row without a usable answer).  The loader's last numbers stand in again rather than a power
+ * source that nobody updates; the next word from either of them says which one it is.
+ */
+void
+hakios_battery_dsp_lost(void)
+{
+	if (battery_source_dsp) {
+		printf("hakios: battery: the DSP's battery manager is quiet; the loader's numbers stand in\n");
+	}
+	battery_source_dsp = 0;
+}
+
+/*
+ * The loader's reading as the power source iOS looks for.
+ *
+ * The battery manager on the audio DSP is the better source where it runs (it counts
+ * charge, and it is what Android shows); this stands in while it does not, so that a
+ * phone whose charger stack is up has a charge to show at all.
+ */
+static void
+battery_report_from_loader(void)
+{
+	struct hakios_battery_state b;
+
+	if (battery_source_dsp || battery_soc_percent < 0 || battery_soc_percent > 100) {
+		return;
+	}
+	memset(&b, 0, sizeof(b));
+	b.size = sizeof(b);
+	b.percent_hundredths = battery_soc_percent * 100;
+	b.voltage_uv = battery_voltage_mv > 0 ? battery_voltage_mv * 1000 : 0;
+	b.current_ua = battery_current_ma * 1000;
+	b.temperature_hundredths = battery_temperature_c * 100;
+	b.present = battery_present;
+	b.external = battery_charger_present;
+	b.status = battery_charging ? 1 : battery_charger_present ? 4 : 2;
+	HakiosBatteryReport(&b, sizeof(b));
+}
