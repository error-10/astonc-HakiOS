 extern void HakiosBatteryReport(const void *state, unsigned size);     /* iokit/Kernel/hakios.battery.cpp */
 
+/*
+ * The last words of a loader that is no longer answering are not the truth any more.  Keep the
+ * percentage (there is nothing better to put in its place, and iOS dislikes a power source that
+ * loses its charge), drop everything that has to be live -- the lightning bolt above all -- and let
+ * iOS know the battery is on its own now.
+ */
+static void
+battery_forget(void)
+{
+	struct hakios_battery_state b;
+
+	battery_voltage_mv = -1;
+	battery_current_ma = 0;
+	battery_temperature_c = -273;
+	battery_charging = 0;
+	battery_charger_present = 0;
+	battery_soc_estimated = 1;
+	bzero(&b, sizeof(b));
+	b.size = sizeof(b);
+	b.percent_hundredths = (battery_soc_percent < 0 ? 0 : battery_soc_percent) * 100;
+	b.present = 1;
+	b.status = 2;			/* POWER_SUPPLY_STATUS_DISCHARGING: nothing is feeding us */
+	battery_updates++;
+	HakiosBatteryReport(&b, sizeof(b));
+}
